//ch 24 challenge 1 (measure local ip with frequent native calls)
//ch 24 challenge 4 (exercise the abs native in a numeric workload)
fun work() {
  var total = 0;
  for (var i = 0; i < 20000000; i = i + 1) {
    total = total + abs(-1);
  }
  return total;
}
var start = clock();
var answer = work();
var elapsed = clock() - start;
print answer;
print elapsed;
