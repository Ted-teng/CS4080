//ch 25 challenge 3 (use a closure to hold private vector coordinates)
fun vector(x, y) {
  fun object(message) {
    //ch 25 challenge 3 (return an addition method when requested)
    if (message == "add") {
      fun add(other) {
        return vector(x + other("x"), y + other("y"));
      }
      return add;
    }
    if (message == "x") return x;
    if (message == "y") return y;
    print "Unknown vector message.";
    return nil;
  }
  return object;
}

var a = vector(1, 2);
var b = vector(3, 4);
var c = a("add")(b);
print c("x");
print c("y");
print a("x");
print a("y");
